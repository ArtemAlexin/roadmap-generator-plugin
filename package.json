{
  "name": "roadmap-generator-plugin",
  "version": "0.0.8",
  "description": "Agent-portable roadmap workflow, MCP server and offline HTML/PDF renderer",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./integrations/opencode/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "roadmap-generator": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:all": "npm test && npm run test:ui",
    "test:opencode": "node scripts/test-opencode.js",
    "demo": "node scripts/demo.js",
    "config": "node src/cli.js config"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.17.1",
    "marked": "^17.0.0",
    "playwright": "^1.56.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtemAlexin/roadmap-generator-plugin.git"
  },
  "homepage": "https://github.com/ArtemAlexin/roadmap-generator-plugin#readme",
  "bugs": {
    "url": "https://github.com/ArtemAlexin/roadmap-generator-plugin/issues"
  },
  "files": [
    "src/",
    "assets/",
    "integrations/",
    "skills/",
    "schema/",
    "scripts/",
    "tests/",
    "docs/",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".codex-plugin/",
    ".agents/plugins/",
    "opencode.json",
    "playwright.config.js"
  ]
}
