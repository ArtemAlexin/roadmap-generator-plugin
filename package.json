{
  "name": "roadmap-generator-plugin",
  "version": "0.1.0",
  "description": "Agent-portable roadmap workflow, MCP server and offline HTML/PDF renderer",
  "type": "module",
  "private": true,
  "exports": { ".": "./integrations/opencode/index.js" },
  "engines": { "node": ">=22" },
  "bin": { "roadmap-generator": "./src/cli.js" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:all": "npm test && npm run test:ui",
    "test:opencode": "node scripts/test-opencode.js",
    "demo": "node scripts/demo.js",
    "config": "node src/cli.js config"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "marked": "^17.0.0",
    "playwright": "^1.56.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0"
  }
}
